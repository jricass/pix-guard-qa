<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <!-- Fixa a transitiva em 2.x corrigida: a 2.0.0 tem vulnerabilidade High (GHSA-v5pm-xwqc-g5wc) e a 3.x quebra a compatibilidade -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.*" />
  </ItemGroup>

  <!-- Permite que o projeto de testes enxergue classes internas -->
  <ItemGroup>
    <InternalsVisibleTo Include="PixGuard.Tests" />
  </ItemGroup>

</Project>
